{
  "info": {
    "name": "Notely API",
    "description": "Colección de endpoints para la aplicación Notely",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/health",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "health"
          ]
        },
        "description": "Verifica el estado del servidor"
      }
    },
    {
      "name": "Get All Notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/notes",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Obtiene todas las notas"
      }
    },
    {
      "name": "Create Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy bread\",\n  \"body\": \"and milk\"\n}"
        },
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/notes",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Crea una nueva nota"
      }
    },
    {
      "name": "Get Note by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/notes/1",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "description": "Obtiene una nota por su ID"
      }
    },
    {
      "name": "Update Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy sourdough\",\n  \"body\": \"from the bakery\"\n}"
        },
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/notes/1",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "description": "Actualiza una nota existente"
      }
    },
    {
      "name": "Delete Note",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/notes/1",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "description": "Elimina una nota por su ID"
      }
    },
    {
      "name": "Get Non-existent Note (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/notes/999",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "notes",
            "999"
          ]
        },
        "description": "Intenta obtener una nota que no existe (esperado: 404)"
      }
    },
    {
      "name": "Test Error Endpoint",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{protocol}}://{{host}}:{{port}}/api/boom",
          "protocol": "{{protocol}}",
          "host": [
            "{{host}}"
          ],
          "port": "{{port}}",
          "path": [
            "api",
            "boom"
          ]
        },
        "description": "Endpoint que genera un error deliberado para testing"
      }
    }
  ],
  "variable": [
    {
      "key": "protocol",
      "value": "http",
      "type": "string"
    },
    {
      "key": "host",
      "value": "localhost",
      "type": "string"
    },
    {
      "key": "port",
      "value": "3000",
      "type": "string"
    }
  ]
}
