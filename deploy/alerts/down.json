{
  "displayName": "Notely is DOWN",
  "combiner": "OR",
  "notificationChannels": ["IT_CHANNEL", "FOUNDER_CHANNEL"],
  "conditions": [{
    "displayName": "Uptime check failing",
    "conditionThreshold": {
      "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id=\"UPTIME_CHECK_ID\" AND resource.type=\"uptime_url\"",
      "comparison": "COMPARISON_GT", "thresholdValue": 1, "duration": "300s",
      "aggregations": [{ "alignmentPeriod": "1200s", "perSeriesAligner": "ALIGN_NEXT_OLDER", "crossSeriesReducer": "REDUCE_COUNT_FALSE", "groupByFields": ["resource.label.*"] }],
      "trigger": { "count": 1 }
    }
  }]
}
